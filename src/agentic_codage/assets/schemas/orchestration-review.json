{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "approve",
        "request_changes"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    }
  },
  "required": [
    "verdict",
    "summary",
    "criteria"
  ],
  "additionalProperties": false
}
