{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "policy",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "currency": {
      "type": "string",
      "minLength": 1,
      "pattern": "[A-Z]{3}"
    },
    "currency_minor_digits": {
      "type": "integer",
      "enum": [
        2
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "name",
          "argv",
          "timeout_seconds"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "max_file_lines": {
      "type": "integer",
      "minimum": 1
    },
    "max_active_tasks": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "schema_version",
    "project",
    "currency",
    "currency_minor_digits",
    "checks",
    "max_file_lines",
    "max_active_tasks"
  ],
  "additionalProperties": false
}
