{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "findings",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "F-[A-Za-z0-9_-]+"
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "resolved"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "evidence": {
      "type": "string",
      "minLength": 1
    },
    "resolution": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "created_at",
    "title",
    "severity",
    "status",
    "owner",
    "paths",
    "evidence",
    "resolution"
  ],
  "additionalProperties": false
}
