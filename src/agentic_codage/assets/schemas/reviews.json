{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "reviews",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "V-[A-Za-z0-9_-]+"
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "task": {
      "type": "string",
      "minLength": 1
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "verdict": {
      "type": "string",
      "enum": [
        "approve",
        "request_changes"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "fingerprint": {
      "type": "string",
      "minLength": 1,
      "pattern": "[a-f0-9]{64}"
    },
    "contract": {
      "type": "string",
      "minLength": 1,
      "pattern": "[a-f0-9]{64}"
    },
    "evidence": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "created_at",
    "task",
    "reviewer",
    "verdict",
    "summary",
    "criteria",
    "fingerprint",
    "contract",
    "evidence"
  ],
  "additionalProperties": false
}
