{
  "checks": [
    {
      "name": "tests",
      "argv": [
        "{python}",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-v"
      ],
      "timeout_seconds": 180
    },
    {
      "name": "adapters",
      "argv": [
        "{python}",
        "bin/framework",
        "adapters",
        "--check"
